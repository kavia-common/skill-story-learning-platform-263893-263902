# Backend FastAPI - Environment Example
# Copy this file to .env and fill in the values for your environment.
# Never commit a real .env with secrets.

# Preferred single URL form (async driver normalized automatically):
# DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname
# or use the individual parts below.
DATABASE_URL=

# Alternatively provide parts (all required if DATABASE_URL is empty)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Alembic (CLI) sync URL override (optional):
# ALEMBIC_DB_URL=postgresql://user:password@host:port/dbname
ALEMBIC_DB_URL=

# Application
APP_SECRET=change-this-in-prod
FRONTEND_ORIGIN=http://localhost:3000

# Token expirations (optional)
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# DB connection resiliency (optional)
DB_CONNECT_MAX_RETRIES=10
DB_CONNECT_BACKOFF_SECONDS=1.5

# Defer heavy seeding to background (recommended true)
DB_SEED_DEFER=true

# Optional helper overrides for utils/run_and_verify_migrations.py
# RUNNING_DB_HOST=
# RUNNING_DB_PORT=
