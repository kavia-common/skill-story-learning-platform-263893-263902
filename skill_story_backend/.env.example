# Copy this file to .env and fill in the values for local development.
# Do NOT commit real secrets.

# Either provide DATABASE_URL or the individual DB_* parts.
# Example for Docker/local Postgres:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/skillstory
DATABASE_URL=

DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Secret used for demo JWT signing and other app crypto
APP_SECRET=replace-with-strong-random-string

# Frontend origin for CORS (e.g., http://localhost:3000)
FRONTEND_ORIGIN=http://localhost:3000
