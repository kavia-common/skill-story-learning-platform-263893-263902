# Backend environment variables (copy to .env and fill values)

# Application secret (required) - use a strong random string
APP_SECRET=replace-with-a-secure-random-string

# Database: prefer single DATABASE_URL (async for app)
# Examples:
#   postgresql+asyncpg://user:password@host:port/dbname
#   postgres://user:password@host:port/dbname   # will be normalized
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/skill_story

# Alternatively, set parts instead of DATABASE_URL:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=skill_story
# DB_USER=postgres
# DB_PASSWORD=postgres

# Alembic (CLI) can use a sync URL if DATABASE_URL is async; optional
# ALEMBIC_DB_URL=postgresql://user:password@localhost:5432/skill_story

# CORS frontend origin (recommended). Use "*" for permissive local testing if needed.
FRONTEND_ORIGIN=http://localhost:3000

# Token expirations (defaults shown)
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# DB connection resiliency (defaults shown)
DB_CONNECT_MAX_RETRIES=10
DB_CONNECT_BACKOFF_SECONDS=1.5

# Defer seeding to background (true/false). Defaults to true.
DB_SEED_DEFER=true
