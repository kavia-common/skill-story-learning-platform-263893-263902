# Example environment variables for Skill Story LMS Backend

# Prefer a single DATABASE_URL; supports postgres://, postgresql://, or postgresql+asyncpg://
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME

# Alternatively provide the parts:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=skill_story
# DB_USER=postgres
# DB_PASSWORD=postgres

# Required application secret for JWT signing
APP_SECRET=change-me-in-prod

# CORS origin (frontend URL). Example: http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# Optional: DB connection resiliency
# Maximum attempts to connect to the database on startup (default: 10)
DB_CONNECT_MAX_RETRIES=10
# Backoff in seconds multiplied by attempt number (default: 1.5)
DB_CONNECT_BACKOFF_SECONDS=1.5
# Defer seeding to background task to avoid blocking readiness (default: true)
DB_SEED_DEFER=true
