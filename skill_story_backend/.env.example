# Database connection
DATABASE_URL=postgresql://user:password@localhost:5432/skillstory

# Application secret (required)
APP_SECRET=CHANGE_ME_SECRET

# Frontend origin for CORS (recommended)
FRONTEND_ORIGIN=http://localhost:3000

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Optional DB connection tuning
DB_CONNECT_MAX_RETRIES=10
DB_CONNECT_BACKOFF_SECONDS=1.5
DB_SEED_DEFER=true
