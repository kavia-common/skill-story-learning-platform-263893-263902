# Backend environment example for Skill Story LMS (FastAPI)

# Database connection
# Preferred: full URL. The app normalizes postgres:// and postgresql:// to asyncpg driver internally.
# Example: postgresql+asyncpg://user:pass@localhost:5432/skillstory
DATABASE_URL=

# OR provide discrete parts (used only if DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skillstory
DB_USER=postgres
DB_PASSWORD=postgres

# App secret for JWT signing (required)
APP_SECRET=change_me

# CORS: Frontend origin (optional but recommended)
FRONTEND_ORIGIN=http://localhost:3000

# Token expirations
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# DB connection resiliency
DB_CONNECT_MAX_RETRIES=10
DB_CONNECT_BACKOFF_SECONDS=1.5

# Seeding behavior: if true, seed will run in background (non-blocking) after startup
DB_SEED_DEFER=true

# Alembic notes:
# - Alembic uses SQLModel models for autogenerate.
# - Ensure DATABASE_URL (sync form for Alembic) is provided for migration operations.
#   Alembic expects a sync SQLAlchemy URL; you can set:
#   ALEMBIC_DB_URL=postgresql://user:pass@host:port/dbname
#   If ALEMBIC_DB_URL is not set, Alembic will try to convert DATABASE_URL to sync form by stripping '+asyncpg'.
# - Common commands:
#   alembic upgrade head      # apply migrations
#   alembic downgrade -1      # rollback last migration
#   alembic revision --autogenerate -m "message"   # generate migration
#   alembic history           # show history
# - First-time setup already includes a baseline and an initial schema + seed migration.
# - If you change models, run autogenerate again to create a new migration file.
