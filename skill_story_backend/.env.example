# Backend environment example for Skill Story LMS

# Use a single DATABASE_URL (async) or specify DB_* parts below.
# Example async URL (preferred by application):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/skill_story

# Alternatively, specify individual parts (the app will compose an async URL):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=skill_story
# DB_USER=postgres
# DB_PASSWORD=postgres

# Alembic CLI prefers a sync URL; you may set this for migration scripts:
# ALEMBIC_DB_URL=postgresql://user:password@host:5432/skill_story

# Secret used to sign JWT tokens (REQUIRED)
APP_SECRET=please-provide-a-strong-secret

# Frontend origin for CORS (recommended)
FRONTEND_ORIGIN=http://localhost:3000

# Token lifetimes (optional)
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# DB connection resiliency (optional)
DB_CONNECT_MAX_RETRIES=10
DB_CONNECT_BACKOFF_SECONDS=1.5
DB_SEED_DEFER=true
